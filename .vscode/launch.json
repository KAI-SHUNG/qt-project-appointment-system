{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Qt 6.11.2 MinGW Debug",
            "type": "cppdbg",
            "request": "launch",

            "program": "${workspaceFolder}/build/debug/09025117.exe",

            "args": [],

            "stopAtEntry": false,

            "cwd": "${workspaceFolder}/build/debug",

            "environment": [
                {
                    "name": "PATH",
                    "value": "D:/Qt/6.11.2/mingw_64/bin;D:/Qt/Tools/mingw1310_64/bin;${env:PATH}"
                }
            ],

            "externalConsole": false,

            "MIMode": "gdb",

            "miDebuggerPath": "D:/Qt/Tools/mingw1310_64/bin/gdb.exe",

            "preLaunchTask": "Qt: build",

            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}