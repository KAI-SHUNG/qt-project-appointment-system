/* 主色 #2196F3 页面底 #F4F6F8 卡片白 分隔 #E6EAF0 */

* {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", sans-serif;
    font-size: 14px;
    color: #1F2329;
    outline: none;
}

MainWindow {
    background: #F4F6F8;
}

/* 导航栏 sidebar */
#sidebar {
    background: #FFFFFF;
    border-right: 1px solid #E6EAF0;
}

#navList {
    background: transparent;
    border: none;
}
#navList::item {
    height: 44px;
    color: #3A3F45;
    border-radius: 6px;
    margin: 2px 10px;
    padding-left: 16px;
}
#navList::item:hover { 
    background: rgba(33, 150, 243, 0.06);
}
#navList::item:selected {
    background: #2196F3;
    color: #FFFFFF;
    font-weight: 600;
}

/* 内容 */
QStackedWidget {
    background: #F4F6F8;
}

#pageTitle {
    font-size: 20px;
    font-weight: 600;
    color: #1F2329;
}
#pageDesc {
    font-size: 13px;
    color: #9AA0A6;
}

/* 按钮
   primary=true  主色实底
   danger=true   危险(删除/退号)
   default      白底描边 */
QPushButton {
    border: 1px solid #D9DEE6;
    border-radius: 6px;
    background: #FFFFFF;
    color: #1F2329;
    padding: 6px 15px;
    min-width: 32px;
}
QPushButton:hover {
    border-color: #2196F3;
    color: #2196F3;
}
QPushButton:pressed {
    background: #F5F8FC;
}

QPushButton[primary="true"] {
    background: #2196F3;
    border: 1px solid #2196F3;
    color: #FFFFFF;
    font-weight: 600;
}
QPushButton[primary="true"]:hover {
    background: #1E88E5;
    border-color: #1E88E5;
}
QPushButton[primary="true"]:pressed {
    background: #1976D2;
}
QPushButton[primary="true"]:disabled {
    background: #A9D4F7;
    border-color: #A9D4F7;
}

QPushButton[danger="true"]:hover {
    border-color: #F44336;
    color: #F44336;
}

QPushButton[link="true"] {
    border: none;
    background: transparent;
    color: #2196F3;
    padding: 2px 6px;
    font-size: 13px;
}
QPushButton[link="true"]:hover {
    color: #1976D2;
    text-decoration: underline;
}

/* 输入控件 */
QComboBox {
    /* border-radius: 6px; */
    background: #FFFFFF;
    padding: 4px 8px;
    selection-background-color: rgba(33, 150, 243, 0.35)
}

QLineEdit,
QSpinBox,
QDateEdit,
QTimeEdit,
QDateTimeEdit,
QTextEdit,
QPlainTextEdit{
    border: 1px solid #D9DEE6;
    border-radius: 6px;
    background: #FFFFFF;
    padding: 4px 8px;
    selection-background-color: rgba(33, 150, 243, 0.35);
}

QLineEdit:focus,
QSpinBox:focus,
QDateEdit:focus,
QTimeEdit:focus,
QDateTimeEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border: 1px solid #2196F3;
}
QLineEdit:disabled,
QSpinBox:disabled,
QDateEdit:disabled,
QTimeEdit:disabled,
QTextEdit:disabled {
    color: #9AA0A6;
    background: #F5F6F8;
}

/* 单选框/复选框 */

QRadioButton,
QCheckBox {
    spacing: 6px;
}
QRadioButton::indicator,
QCheckBox::indicator {
    width: 16px;
    height: 16px;
}
QRadioButton::indicator:checked,
QCheckBox::indicator:checked {
    background: #2196F3;
    border: 1px solid #2196F3;
    border-radius: 4px;
}
QRadioButton::indicator,
QCheckBox::indicator {
    border: 1px solid #B9C0C9;
    border-radius: 4px;
    background: #FFFFFF;
}

/* 表格 */
QTableWidget,
QTableView {
    background: #FFFFFF;
    border: 1px solid #E6EAF0;
    border-radius: 8px;
    gridline-color: transparent;
    alternate-background-color: #F9FBFD;
}
QTableWidget::item,
QTableView::item {
    padding: 4px 6px;
    border-bottom: 1px solid #F0F2F5;
}
QTableWidget::item:selected,
QTableView::item:selected {
    background: rgba(33, 150, 243, 0.12);
    color: #1F2329;
}
QHeaderView::section {
    background: #FAFBFC;
    color: #5A6068;
    border: none;
    border-bottom: 1px solid #E6EAF0;
    padding: 8px 6px;
    font-weight: 600;
}
QTableCornerButton::section {
    background: #FAFBFC;
    border: none;
}

/* 卡片 */
QLabel[cardTitle="true"] {
    font-size: 16px;
    font-weight: 600;
    color: #1F2329;
}
QLabel[weak="true"] {
    color: #9AA0A6;
}
QLabel[sub="true"] {
    color: #5A6068;
}

/* 滚动条 */
QScrollBar:vertical { background: transparent; width: 8px; margin: 2px; }
QScrollBar::handle:vertical { background: #C7CDD6; border-radius: 4px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #A9B0BB; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: 8px; margin: 2px; }
QScrollBar::handle:horizontal { background: #C7CDD6; border-radius: 4px; min-width: 30px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ---------------- 提示框与下拉等杂项 ------------- */
QToolTip {
    background: #FFFFFF;
    color: #1F2329;
    border: 1px solid #E6EAF0;
    padding: 4px 6px;
}
