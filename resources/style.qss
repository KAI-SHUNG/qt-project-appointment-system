/* 配色 主蓝#2196F3(hover#1E88E5 pressed#1976D2 禁用#A9D4F7) */
/* 文字#1F2329 次#5A6068 弱#9AA0A6 危险#F44336 */
/* 页面底#F4F6F8 卡片白#FFFFFF 分隔#E6EAF0 输入边#D9DEE6 */
/* 字体 16 20 24 */

* {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", sans-serif;
    font-size: 16px;
    color: #1F2329;
    outline: none;
}

MainWindow {
    background: #F4F6F8;
}

/* 导航栏 sidebar */
QWidget#sidebar {
    background: #FFFFFF;
    border-right: 1px solid #E6EAF0;
}
QListWidget#navList {
    font-size: 16px;
    background: transparent;
    border: none;
}
QListWidget#navList::item {
    height: 48px;
    border-radius: 6px;
    margin: 4px 10px;
    padding-left: 16px;
}
QListWidget#navList::item:hover { 
    background: rgba(33, 150, 243, 0.06);
}
QListWidget#navList::item:selected {
    background: #2196F3;
    color: #FFFFFF;
    /* font-weight 对 ::item 无效，选中加粗由 mainwindow.cpp 的 NavItemDelegate 完成 */
}

/* 内容 */
QStackedWidget {
    background: #F4F6F8;
}

QLabel#pageTitle {
    font-size: 24px;
    font-weight: 700;
    color: #1F2329;
}

/* 占位页（未落地页面的居中灰字） */
QLabel[placeholder="true"] {
    font-size: 22px;
    font-weight: 700;
    color: #9AA0A6;
}

/* 按钮
   primary=true  主色实底
   danger=true   危险(删除/退号)
   default      白底描边 */
QPushButton {
    border: 1px solid #D9DEE6;
    border-radius: 6px;
    background: #FFFFFF;
    color: #1F2329;
    padding: 6px 16px;
    min-width: 32px;
}
QPushButton:hover {
    border-color: #2196F3;
    color: #2196F3;
}
QPushButton:pressed {
    background: #F5F8FC;
}

QPushButton[primary="true"] {
    border: 1px solid #2196F3;
    background: #2196F3;
    color: #FFFFFF;
    font-weight: 700;
}
QPushButton[primary="true"]:hover {
    background: #1E88E5;
    border-color: #1E88E5;
}
QPushButton[primary="true"]:pressed {
    background: #1976D2;
}
QPushButton[primary="true"]:disabled {
    background: #A9D4F7;
    border-color: #A9D4F7;
}

QPushButton[danger="true"]:hover {
    border-color: #F44336;
    color: #F44336;
}

/* Timeslot action buttons must keep all four Chinese characters visible. */
TimeslotDialog QPushButton#btnAdd,
TimeslotDialog QPushButton#btnRemove {
    min-width: 72px;
}

QPushButton[link="true"] {
    border: none;
    background: transparent;
    color: #2196F3;
    padding: 2px 6px;
}
QPushButton[link="true"]:hover {
    color: #1976D2;
    text-decoration: underline;
}

/* 输入控件 */
QComboBox,
QDateEdit,
QTimeEdit,
QDateTimeEdit,
QSpinBox {
    /* border-radius: 6px; */
    background: #FFFFFF;
    padding: 4px 12px;
    selection-background-color: rgba(33, 150, 243, 0.35)
}

QLineEdit,
QTextEdit,
QPlainTextEdit{
    border: 1px solid #D9DEE6;
    border-radius: 6px;
    background: #FFFFFF;
    padding: 4px 12px;
    selection-background-color: rgba(33, 150, 243, 0.35);
}

QLineEdit:focus,
/* QSpinBox:focus, */
/* QDateEdit:focus,
QTimeEdit:focus, */
/* QDateTimeEdit:focus, */
QTextEdit:focus,
QPlainTextEdit:focus {
    border: 1px solid #2196F3;
}
QLineEdit:disabled,
/* QSpinBox:disabled, */
/* QDateEdit:disabled,
QTimeEdit:disabled, */
QTextEdit:disabled {
    color: #9AA0A6;
    background: #F5F6F8;
}

/* 单选框/复选框 */
QRadioButton,
QCheckBox {
    spacing: 4px;
}
QRadioButton::indicator,
QCheckBox::indicator {
    width: 16px;
    height: 16px;

    background: #FFFFFF;
    border: 1px solid #B9C0C9;
    border-radius: 4px;
}
QRadioButton::indicator:checked,
QCheckBox::indicator:checked {
    background: #2196F3;
    border: 1px solid #2196F3;
    border-radius: 4px;
}

/* 表格 */
QTableWidget,
QTableView {
    background: #FFFFFF;
    border: 1px solid #E6EAF0;
    border-radius: 8px;
    gridline-color: transparent;
    alternate-background-color: #F9FBFD;
}
QTableWidget::item,
QTableView::item {
    border-bottom: 1px solid #F0F2F5;
    padding: 4px 6px;
}
QTableWidget::item:selected,
QTableView::item:selected {
    background: rgba(33, 150, 243, 0.12);
    color: #1F2329;
}
QHeaderView::section {
    background: #FAFBFC;
    color: #5A6068;
    border: none;
    border-bottom: 1px solid #E6EAF0;
    padding: 8px 6px;
    font-weight: 700;
}
QTableCornerButton::section {
    background: #FAFBFC;
    border: none;
}

/* 卡片 */
QLabel[cardTitle="true"] {
    font-size: 16px;
    font-weight: 700;
    color: #1F2329;
}
QLabel[weak="true"] {
    color: #9AA0A6;
}
QLabel[sub="true"] {
    color: #5A6068;
}

QFrame[card="true"] {
    background: #FFFFFF;
    border: 1px solid #E6EAF0;
    border-radius: 10px;
}

QListWidget#lstSlots {
    background: #FFFFFF;
    border: 1px solid #E6EAF0;
    border-radius: 6px;
    padding: 4px;
}
QListWidget#lstSlots::item {
    border-radius: 5px;
    padding: 8px 10px;
    margin: 2px;
}
QListWidget#lstSlots::item:hover {
    background: rgba(33, 150, 243, 0.06);
}
QListWidget#lstSlots::item:selected {
    background: rgba(33, 150, 243, 0.16);
    color: #1976D2;
}
QListWidget#lstSlots::item:disabled {
    color: #9AA0A6;
    background: #F5F6F8;
}

/* 滚动条 */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px;
}
QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #C7CDD6;
    border-radius: 4px;
    min-height: 30px; 
}
QScrollBar::handle:vertical:hover {
    background: #A9B0BB;
}
QScrollBar::handle:horizontal {
    background: #C7CDD6;
    border-radius: 4px;
    min-width: 30px;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}
QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
}

/* 提示框与下拉 */
QToolTip {
    background: #FFFFFF;
    color: #1F2329;
    border: 1px solid #E6EAF0;
    padding: 6px 12px;
}
